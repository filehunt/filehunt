# Version control
.git/
.gitignore

# Build artifacts
**/target/
**/node_modules/
**/dist/
**/build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
