{
  "name": "Git Service API",
  "description": "Collection pour tester l'API du git-service FileHunt",
  "requests": {
    "health_check": {
      "name": "Health Check",
      "description": "Vérifier le statut de santé du service",
      "method": "GET",
      "url": "http://localhost:3000/health",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "readiness_check": {
      "name": "Readiness Check", 
      "description": "Vérifier si le service est prêt",
      "method": "GET",
      "url": "http://localhost:3000/ready"
    },
    "create_repository": {
      "name": "Create Repository",
      "description": "Créer un nouveau repository",
      "method": "POST",
      "url": "http://localhost:3000/repositories",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "test-repo",
        "owner": "testuser", 
        "description": "Repository de test pour l'API"
      }
    },
    "list_repositories": {
      "name": "List Repositories",
      "description": "Lister tous les repositories",
      "method": "GET",
      "url": "http://localhost:3000/repositories",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "get_repository": {
      "name": "Get Repository",
      "description": "Obtenir les détails d'un repository",
      "method": "GET", 
      "url": "http://localhost:3000/repositories/testuser_test-repo",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "create_first_commit": {
      "name": "Create First Commit",
      "description": "Créer le premier commit",
      "method": "POST",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "Initial commit - Added main configuration file",
        "author": "testuser@example.com",
        "file_path": "/config/app.yaml",
        "repository_id": "testuser_test-repo"
      }
    },
    "create_second_commit": {
      "name": "Create Second Commit", 
      "description": "Créer un deuxième commit",
      "method": "POST",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "feat: Added user authentication module", 
        "author": "testuser@example.com",
        "file_path": "/src/auth.rs",
        "repository_id": "testuser_test-repo"
      }
    },
    "list_commits": {
      "name": "List All Commits",
      "description": "Lister tous les commits",
      "method": "GET",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "list_commits_paginated": {
      "name": "List Commits Paginated",
      "description": "Lister les commits avec pagination",
      "method": "GET", 
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits?limit=1&offset=0",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "get_commit": {
      "name": "Get Commit Details",
      "description": "Obtenir les détails d'un commit (modifier l'ID)",
      "method": "GET",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits/REPLACE_WITH_COMMIT_ID",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "get_commit_full": {
      "name": "Get Full Commit Details",
      "description": "Obtenir les détails complets avec métadonnées", 
      "method": "GET",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits/REPLACE_WITH_COMMIT_ID/details",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "download_commit_file": {
      "name": "Download Commit File",
      "description": "Télécharger le fichier d'un commit",
      "method": "GET",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits/REPLACE_WITH_COMMIT_ID/file",
      "headers": {
        "Accept": "*/*"
      }
    },
    "create_prod_repo": {
      "name": "Create Production Repository", 
      "description": "Créer un repository de production",
      "method": "POST",
      "url": "http://localhost:3000/repositories",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "production-app",
        "owner": "devops",
        "description": "Repository principal de l'application"
      }
    },
    "create_hotfix": {
      "name": "Create Hotfix Commit",
      "description": "Créer un commit de correction urgente",
      "method": "POST", 
      "url": "http://localhost:3000/repositories/devops_production-app/commits",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "hotfix: Fix critical security vulnerability",
        "author": "security@company.com",
        "file_path": "/src/security/auth.rs", 
        "repository_id": "devops_production-app"
      }
    },
    "error_repo_not_found": {
      "name": "Error - Nonexistent Repository",
      "description": "Test erreur pour repository inexistant",
      "method": "GET",
      "url": "http://localhost:3000/repositories/nonexistent_repo",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "error_commit_not_found": {
      "name": "Error - Nonexistent Commit",
      "description": "Test erreur pour commit inexistant", 
      "method": "GET",
      "url": "http://localhost:3000/repositories/testuser_test-repo/commits/00000000-0000-0000-0000-000000000000",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "error_invalid_data": {
      "name": "Error - Invalid Repository",
      "description": "Test validation avec données invalides",
      "method": "POST",
      "url": "http://localhost:3000/repositories",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "",
        "owner": "",
        "description": null
      }
    }
  }
}