# E2E Testing Environment Configuration

# Git Service Configuration
GIT_SERVICE_URL=http://localhost:3000
GIT_SERVICE_TIMEOUT=30

# LocalStack Configuration (for development)
LOCALSTACK_URL=http://localhost:4566
S3_BUCKET=git-service-bucket
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Test Data Configuration
TEST_REPOSITORY_PREFIX=e2e-test
TEST_USER_EMAIL=e2e-tester@example.com
TEST_OWNER=e2e-automation

# HTTPie Configuration
HTTPIE_TIMEOUT=30
HTTPIE_FOLLOW_REDIRECTS=true
HTTPIE_VERIFY_SSL=false

# Logging
LOG_LEVEL=info
TEST_OUTPUT_DIR=./test-results

# Cleanup Configuration
AUTO_CLEANUP=true
KEEP_TEST_DATA=false

# Parallel Testing
MAX_CONCURRENT_TESTS=5
TEST_RETRY_COUNT=3
TEST_RETRY_DELAY=2

# Production Environment (uncomment for prod testing)
# GIT_SERVICE_URL=https://git-service.production.com
# AWS_ACCESS_KEY_ID=your-production-key
# AWS_SECRET_ACCESS_KEY=your-production-secret
# S3_BUCKET=production-git-service-bucket
# HTTPIE_VERIFY_SSL=true