		{
			"name": "File Upload Flow",
			"item": [
				{
					"name": "1. Prepare Upload",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('file_id', response.file_id);",
									"    pm.environment.set('version_id', response.version_id);",
									"    pm.environment.set('presigned_url', response.presigned_url);",
									"    pm.environment.set('s3_key', response.s3_key);",
									"    console.log('File ID:', response.file_id);",
									"    console.log('Version ID:', response.version_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"filename\": \"test-document.pdf\",\n    \"content_type\": \"application/pdf\",\n    \"file_size\": 1024000,\n    \"tags\": {\n        \"category\": \"document\",\n        \"department\": \"engineering\",\n        \"confidential\": false\n    },\n    \"commit_message\": \"Initial upload of test document\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/files/prepare",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"files",
								"prepare"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Upload to S3 (Manual Step)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/pdf"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "This is a mock PDF content for testing purposes. In a real scenario, you would upload the actual file binary data here."
						},
						"url": {
							"raw": "{{presigned_url}}",
							"host": [
								"{{presigned_url}}"
							]
						},
						"description": "This step uploads the file directly to S3 using the presigned URL. In Postman, you would typically use a file upload here."
					},
					"response": []
				},
				{
					"name": "3. Complete Upload",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('commit_hash', response.commit_hash);",
									"    pm.environment.set('version_number', response.version_number);",
									"    console.log('Upload completed successfully');",
									"    console.log('Version number:', response.version_number);",
									"    console.log('Commit hash:', response.commit_hash);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"file_id\": \"{{file_id}}\",\n    \"version_id\": \"{{version_id}}\",\n    \"etag\": \"mock-etag-12345\",\n    \"actual_file_size\": 1024000\n}"
						},
						"url": {
							"raw": "{{base_url}}/files/complete",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"files",
								"complete"
							]
						}
					},
					"response": []
				}
			],
			"description": "Complete flow for uploading a new file"
		},
