# File Service Environment Configuration

# Server Configuration
SERVER_PORT=3001

# Database Configuration
DATABASE_URL=postgresql://filehunt:filehunt_password@localhost:5432/filehunt

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 Configuration
S3_ENDPOINT=http://localhost:4566
S3_FILE_BUCKET=filehunt-files
S3_GIT_BUCKET=filehunt-git
S3_SHARED_BUCKET=filehunt-shared
S3_PROCESSING_BUCKET=filehunt-processing
S3_PRESIGNED_URL_EXPIRY=3600
S3_KMS_KEY_ID=alias/filehunt-file-encryption

# SNS Configuration
SNS_ENDPOINT=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:filehunt-file-events

# SQS Configuration
SQS_ENDPOINT=http://localhost:4566

# External Services
GIT_SERVICE_URL=http://localhost:3000

# Application Settings
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,text/plain,application/pdf,video/mp4,audio/mpeg,application/json,text/markdown

# Logging
LOG_LEVEL=info
RUST_LOG=file_service=debug,tower_http=debug